# ===== Amusement Park MCP Server Configuration =====
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT .env to git - it contains secrets!

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your-account-id
SNOWFLAKE_HOST=your-account-id.snowflakecomputing.com
SNOWFLAKE_WAREHOUSE=your-warehouse-name
SNOWFLAKE_DATABASE=your-database-name
SNOWFLAKE_SCHEMA=your-schema-name

# MCP Server Configuration
SERVER_PORT=8080
MCP_API_KEY=your-secret-api-key-here

# Entra ID / Identity Mapping
ENTRA_MAP_TABLE=your_db.your_schema.ENTRA_USER_MAP
CACHE_TTL_SECONDS=300

# Cortex Agent Configuration
AGENT_FQN=your_db.your_schema.your_agent_name

# Default Entra User (fallback)
DEFAULT_ENTRA_USER=default-user@example.com

# Logging
LOG_LEVEL=INFO
